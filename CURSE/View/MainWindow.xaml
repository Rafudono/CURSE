<Window x:Class="CURSE.MainWindow.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CURSE" 
        xmlns:viewmodel="clr-namespace:CURSE.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:MainVM}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Horizontal">
                <Image/>
                <Label Content="CURSE"/>
            </StackPanel>
            
            <Menu  >
                <MenuItem Header="Соискатель"/>
                <MenuItem Header="Работодатель"/>
            </Menu>
        </StackPanel>
        
        <Frame Content="{Binding CurrentPage}" />
        <StackPanel Grid.Column="9">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Login"/>
            <Button Content="Registration"/>
            </StackPanel>
            <WrapPanel >
                <TextBlock Text="ЗДЕСЬ МОГЛА БЫТЬ ВАША РЕКЛАМА" TextWrapping="Wrap"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
