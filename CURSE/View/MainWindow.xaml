<Window x:Class="CURSE.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CURSE.Model" 
        xmlns:vm="clr-namespace:CURSE.ViewModel" 
        DataContext="{DynamicResource vm}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <vm:MainVM x:Key="vm"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image/>
            <Label Content="CURSE"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content="Роль:" Margin="0"/>
                <Label Content="Гость" Margin="0" Grid.Column="1" Visibility="{Binding Guest}"/>
                <Label Content="Работодатель" Margin="0" Grid.Column="1" Visibility="{Binding RoleEmp}"/>
                <Label Content="Соискатель" Margin="0" Grid.Column="1" Visibility="{Binding RoleAppl}"/>
            </Grid>
        </StackPanel>
        <Frame Content="{Binding CurPage}" Grid.Row="3" NavigationUIVisibility="Hidden"/>
        <Menu Grid.Row="1">
            <MenuItem Header="Соискатель" Command="{Binding ListVac}"/>
            <MenuItem Header="Работодатель" Command="{Binding ListRes}" />
            <MenuItem Header="Мои вакансии" Visibility="{Binding VisMyVac}" Command="{Binding ListMyVac}"/>
        </Menu>
        <Grid HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Content="Login" Command="{Binding Login}" Visibility="{Binding AuthVis}"/>
            <Button Content="Registration" Command="{Binding Registration}" Visibility="{Binding Reg}" Grid.Column="1"/>
            <Button Content="Выйти" Command="{Binding LogOut}" Visibility="{Binding LogOutVis}" Grid.Column="1"/>
            <Grid Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Content="Моё резюме" Visibility = "{Binding Resume}" Command="{Binding ChangeResWindow}" Grid.Column="1"/>
                <Button Content="Документы" Visibility="{Binding Documents}" Command="{Binding MyDoc}" Grid.Column="1"/>
                <ComboBox Grid.Column="2" x:Name="ComboSettings" Visibility="{Binding Settings}">
                    <StackPanel>
                        <Button Content="Мой профиль" Command="{Binding SettingsWindow}"/>
                        <Button Content="Удалить аккаунт" Command="{Binding DelUser}"/>
                    </StackPanel>
                </ComboBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
