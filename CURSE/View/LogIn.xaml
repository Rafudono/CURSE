<Window x:Class="CURSE.View.LogIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CURSE.View"
        xmlns:vm="clr-namespace:CURSE.ViewModel" 
        DataContext="{DynamicResource vm}"
        mc:Ignorable="d"
        Title="LogIn"  Height="400" Width="600">
    <Window.Resources>
        <vm:LoginVM x:Key="vm"/>
    </Window.Resources>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
        <Label Content="Почта"/>
        <TextBox Text="{Binding loginEmail}"/>
        <Label Content="Пароль"/>
        <TextBox Text="{Binding loginPassword}"/>
        <Button Content="Войти" />
    </StackPanel>
   
</Window>
