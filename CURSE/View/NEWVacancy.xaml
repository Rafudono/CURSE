<Window x:Class="CURSE.View.NEWVacancy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CURSE.View"         
        xmlns:vm="clr-namespace:CURSE.ViewModel" 
        DataContext="{DynamicResource vm}"
        mc:Ignorable="d"
        Title="Новая вакансия" Height="450" Width="800">
    <Window.Resources>
        <vm:NEWVacancyVM x:Key="vm"/>
        <Style x:Key="listItemFoa" TargetType="ListBoxItem">
            <Setter Property="IsSelected" Value="{Binding Selected}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Label Content="Специальность(название вакансии)"/>
            <TextBox Text="{Binding Vac.Title}"/>
            <StackPanel Orientation="Horizontal">
                <Label Content="Выберите город"/>
                <ComboBox DisplayMemberPath="City_Name" ItemsSource="{Binding Citys}" SelectedItem="{Binding SelectedCity}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Требуемый опыт"/>
                <TextBox Text="{Binding Vac.XP}"/>
                <Label Content="Требуемое образование"/>
                <ComboBox DisplayMemberPath="Title" SelectedItem="{Binding SelectedEducation}" ItemsSource="{Binding Educations}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Content="Заработная плата"/>
                <Label Content="от"/>
                <TextBox Text="{Binding Vac.MINSalary}"/>
                <Label Content="до"/>
                <TextBox Text="{Binding Vac.MAXSalary}"/>
            </StackPanel>
            <Label Content="Описание"/>
            <TextBox Text="{Binding Vac.Description}" TextWrapping="Wrap"/>
            <Label Content="Обязанности"/>
            <TextBox Text="{Binding Vac.Responsibilities}" TextWrapping="Wrap"/>
            <Label Content="Требования"/>
            <TextBox Text="{Binding Vac.Requirements}" TextWrapping="Wrap"/>
            <Label Content="Условия"/>
            <TextBox Text="{Binding Vac.Conditions}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Только полная занятость" IsChecked="{Binding Vac.IsFullEmployment}"/>
                <CheckBox Content="Возможен гибкий график работы" IsChecked="{Binding Vac.IsFlexibleSchedule}"/>
            </StackPanel>
            <Button Content="Save" HorizontalAlignment="Center" Command="{Binding Save}"/>
                
        </StackPanel>
        <ListBox DisplayMemberPath="Title" Grid.Column="3" 
     ItemContainerStyle="{StaticResource listItemFoa}"
     ItemsSource="{Binding Fields}"
     SelectionMode="Multiple"
x:Name="listFoa"/>
    </Grid>
</Window>