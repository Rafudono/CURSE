<Window x:Class="CURSE.View.MyDocuments"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CURSE.View" 
        xmlns:vm="clr-namespace:CURSE.ViewModel" 
 DataContext="{DynamicResource vm}"
 mc:Ignorable="d"
 Title="Документы" Height="450" Width="550">

    <Window.Resources>
        <vm:MyDocumentsVM x:Key="vm"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="Ваша организация" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="50"/>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBox Text="{Binding Emp.Org_Name}" MinWidth="100" MinHeight="30"/>
            <Label Content="ИНН" IsEnabled="False"/>
            <Label Content="КПП" IsEnabled="False"/>
        </StackPanel>
        <Button Content="Сохранить" Grid.Row="4" Grid.ColumnSpan="3" Command="{Binding Save}" MinHeight="50" MaxWidth="100"/>
    </Grid>

</Window>
