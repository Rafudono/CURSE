<Window x:Class="CURSE.View.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CURSE.View"
        mc:Ignorable="d"
        Title="Registration" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
        <Label Content="Почта"/>
        <TextBox/>
        <Button Content="Продолжить"/>
    </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden">
            <Label Content="Имя"/>
            <TextBox/>
            <Label Content="Фамилия"/>
            <TextBox/>
            <Button Content="Назад"/>
            <Button Content="Продолжить"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden">
            <Label Content="Телефон"/>
            <TextBox/>
            <Button Content="Назад"/>
            <Button Content="Продолжить"/>
        </StackPanel>
    </Grid>
</Window>
    
