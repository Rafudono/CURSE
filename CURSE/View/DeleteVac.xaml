<Window x:Class="CURSE.View.DeleteVac"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CURSE.View"
                       xmlns:vm="clr-namespace:CURSE.ViewModel" 
DataContext="{DynamicResource vm}"
        mc:Ignorable="d"
        Title="DeleteUser" Height="300" Width="300">
    <Window.Resources>
        <vm:DelteVacVM x:Key="vm"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
            <Label Content="Удаление вакансии" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SelectedVac.Title}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <Label Content="Введите текущий пароль"/>
            <TextBox Text="{Binding password}"/>
        </StackPanel>
        <Button Content="Удалить" Grid.Row="3" HorizontalAlignment="Center" Command="{Binding Delete}"/>
    </Grid>
</Window>
