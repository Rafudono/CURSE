<Window x:Class="CURSE.View.ChangeData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CURSE.Converters"
            xmlns:vm="clr-namespace:CURSE.ViewModel" 
    DataContext="{DynamicResource vm}"
    mc:Ignorable="d"
   Title="ChangeData" Height="500" Width="500">
    <Window.Resources>
        <local:NullImageConverter x:Key="nullImageConverter"/>
        <vm:ChangeDataVM x:Key="vm"/>
    </Window.Resources>
    <StackPanel>
    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Center">
                <Label Content="Личные данные"/>
            </StackPanel>
            <Image Height="240" Width="180" Source="{Binding Hum.Photo, Converter={StaticResource nullImageConverter}}" Grid.Row="1"/>
            <Button Content="Выбрать фото" Grid.Row="2" Command="{Binding PickImage}"/>
            <StackPanel Grid.Column="1" Grid.Row="1">
                <TextBlock Text="Имя"/>
                <TextBox Text="{Binding Hum.Name}"/>
                <TextBlock Text="Фамилия"/>
                <TextBox Text="{Binding Hum.Surname}"/>
                <TextBlock Text="Отчество"/>
                <TextBox Text="{Binding Hum.Middle_Name}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1">
                <Label Content="День рождения"/>
                <DatePicker SelectedDate="{Binding Hum.Birthday, StringFormat= dd mm yyyy}"/>
            </StackPanel>
        </Grid>
       
        <Label Content="Контактные данные" HorizontalAlignment="Center"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Content="Email"  HorizontalAlignment="Right"/>
            <TextBox Text="{Binding Hum.Email}" Grid.Column="1"/>
            <Label Content="Телефон" Grid.Row="1"  HorizontalAlignment="Right"/>
            <TextBox Text="{Binding Hum.PhoneNumber}" Grid.Row="1" Grid.Column="1"/>
        </Grid>
       
        <Label Content="Изменение пароля" HorizontalAlignment="Center"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Введите новый пароль" Grid.Row="1"/>
            <TextBox Text="{Binding NewPassword}" Grid.Row="1" Grid.Column="1"/>
        </Grid>
        <TextBlock Text="Введите текущий пароль" HorizontalAlignment="Center"/>
        <TextBox Text="{Binding CurPassword}" Grid.Column="1"/>
        <Button Content="Сохранить изменения" Command="{Binding Save}"/>
    </StackPanel>
</Window>
